# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交真实凭证。
# 部署到 CloudBase 时，这些值应配置为云函数 upcycle-api 的环境变量，不要把 .env 上传静态站。
# 线上目前用 npm run deploy:live 从 ~/.workbuddy/models.json 读取 Qwen 配置注入，无需手写密钥。

# ---------- 方案生成：Chat Completions 兼容服务 ----------
# 三项全填才会进入「模型模式」；缺任意一项时页面明确显示「示例模式」，只给本地规则方案。
# 服务端读取，前端无法指定上游地址，密钥不会下发到浏览器。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 本地默认 false；线上由 npm run deploy:live 默认注入 true（已真发请求验证 qwen3.8-flash
# 接受 image_url 并能看图判断物品），显式 UPCYCLE_VISION=false npm run deploy:live 才关闭。
# false / 留空时不上传图片，也不会声称识图。
LLM_VISION=false

# Qwen/DashScope 的长 JSON 输出默认会先「思考」：实测完整三方案要 76 秒，容易被网关超时打断。
# 设为 true 时服务端才传厂商参数 enable_thinking:false（实测降到约 22 秒）；其他端点保持不传。
LLM_DISABLE_THINKING=false

# 兼容的 Qwen/DashScope 端点可设为 true，强制模型返回可解析的 JSON 对象，降低格式失败率；
# 其他端点保持 false（不发送厂商参数）。
LLM_JSON_MODE=false
LLM_TIMEOUT_MS=20000

# ---------- 照片文字识别：腾讯云 GeneralBasicOCR ----------
# OCR 现状（2026-11-07）：文字识别服务已开通；账号本人已在 CAM 给运行时角色
# TCB_QcsRole 关联 QcloudOCRReadOnlyaccess，线上真实 OCR 已跑通。
# 因此下面三项**留空即可**，直接使用云函数运行时注入的临时密钥，无需任何长期密钥。
# 仅当临时密钥失效、或需要把权限隔离到专用子账号时，才填仅授权 OCR 的子账号密钥（勿用主账号密钥）。
# 这三项优先于运行时临时密钥；临时密钥作兜底。
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_CLOUD_TOKEN=
TENCENTCLOUD_REGION=ap-shanghai
OCR_TIMEOUT_MS=12000

# ---------- 公开接口护栏（云端云函数环境变量，本地可留空） ----------
# 每来源 IP 每 60 秒允许的基础请求数；ocr 为其 2 倍，设 0 关闭计数。
# 计数只在单个云函数容器内有效，是轻量护栏，不替代平台侧限流。
# UPCYCLE_RATE_LIMIT=12

# ---------- 本地预览 ----------
PORT=4173
