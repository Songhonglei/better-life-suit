                "note": "利于根系呼吸"
              },
              {
                "needs": [
                  "tape"
                ],
                "text": "用胶带固定石子位置（非必须）。",
                "minutes": 3,
                "note": "仅起临时作用"
              }
            ],
            "optional": false
          },
          {
            "label": "填土种植",
            "variants": [
              {
                "needs": [
                  "hands"
                ],
                "text": "倒入适量泥土并压实中心区域。",
                "minutes": 5,
                "note": "留出空间给幼苗"
              },
              {
                "needs": [
                  "ruler"
                ],
                "text": "用尺子辅助整理表面平整度。",
                "minutes": 3,
                "note": "提升视觉效果"
              }
            ],
            "optional": false
          }
