          "labels": [
            "瓶口边缘",
            "瓶身主体"
          ]
        },
        "materials": [
          {
            "name": "空洗发水瓶",
            "qty": "适量",
            "cost": 0,
            "optional": false,
            "requires": [],
            "note": "需洗净晾干"
          },
          {
            "name": "装饰贴纸",
            "qty": "适量",
            "cost": 2,
            "optional": true,
            "requires": [],
            "note": "可选"
          }
        ],
        "steps": [
          {
            "label": "裁剪瓶身",
            "variants": [
              {
                "needs": [
                  "scissors"
                ],
                "text": "用铅笔沿瓶身画线，剪刀沿线剪开。",
                "minutes": 5,
                "note": "注意切口平整"
              },
              {
                "needs": [
                  "hands"
                ],
                "text": "反复弯折瓶颈处直至断裂（效果差）。",
                "minutes": 15,
                "note": "边缘可能不整齐"
              }
            ],
            "optional": false
          },
          {
            "label": "打磨边缘",
            "variants": [
              {
                "needs": [
                  "scissors"
                ],
                "text": "修剪毛刺，使边缘圆润。",
                "minutes": 3,
                "note": "小心割手"
              },
              {
                "needs": [
                  "hands"
                ],
                "text": "用手指按压边缘使其贴合。",
                "minutes": 5,
                "note": "无法完全去除锋利感"
              }
            ],
            "optional": false
          },
          {
            "label": "外观美化",
            "variants": [
              {
                "needs": [
                  "glue"
                ],
                "text": "粘贴装饰纸或贴纸包裹瓶身。",
                "minutes": 10,
                "note": "增加美观度"
              },
              {
                "needs": [
                  "hands"
                ],
                "text": "直接摆放使用。",
                "minutes": 1,
                "note": "保留原包装风格"
              }
            ],
            "optional": false
          }
        ],
        "notes": [
          "切口处可用胶带缠绕一圈防割手",
          "避免盛放热水或尖锐物品"
        ],
        "isFallback": false,
        "isGeneric": false
      },
